# Copy conventions:
#   `uv run serveshed init` copies this file to `.env`, fills every
#   CHANGE_ME/GENERATE_ME placeholder with a generated secret, and sets file
#   mode 0600. Never commit `.env`; only this template is tracked.
# Fields marked REVIEW_REQUIRED are gated: review provenance/license/eval
# evidence before setting them (see README.md and docs/models.md).

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=serveshed

# Default gateway model alias; change with `serveshed model select` (see
# config/models/registry.yaml for the full hardware-aware profile matrix).
SERVESHED_DEFAULT_MODEL_ALIAS=local/qwen-fast

# ---------------------------------------------------------------------------
# Pinned image tags (candidate pins; verify digest/publisher before first
# pull and record results in ADR 0006 — see scripts/verify-images.sh)
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.9-alpine
PHOENIX_IMAGE=arizephoenix/phoenix:version-20.2.0
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.158.0
BIFROST_IMAGE=maximhq/bifrost:v1.6.10
OLLAMA_IMAGE=ollama/ollama:0.32.9
VLLM_IMAGE=vllm/vllm-openai:v0.27.1-cu129-ubuntu2404
PROMPTFOO_IMAGE=ghcr.io/promptfoo/promptfoo:0.122.0
LITELLM_IMAGE=litellm/litellm:v1.96.2
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

# ---------------------------------------------------------------------------
# Localhost-only published ports
# ---------------------------------------------------------------------------
BIFROST_PORT=8080
PHOENIX_PORT=6006
LITELLM_PORT=4000
OPENWEBUI_PORT=3000

# ---------------------------------------------------------------------------
# Storage paths (local NVMe by default; Synology is optional/later)
# ---------------------------------------------------------------------------
SERVESHED_DATA_DIR=~/.local/share/serveshed
SERVESHED_CACHE_DIR=~/.cache/serveshed
SERVESHED_NAS_DIR=/mnt/synology-ai

# ---------------------------------------------------------------------------
# PostgreSQL (superuser plus separate Phoenix/Bifrost roles and databases)
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER=serveshed_admin
POSTGRES_SUPERUSER_DB=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_GENERATE_ME

PHOENIX_DB_USER=phoenix
PHOENIX_DB_NAME=phoenix
PHOENIX_DB_PASSWORD=CHANGE_ME_GENERATE_ME

BIFROST_DB_USER=bifrost
BIFROST_DB_NAME=bifrost
BIFROST_DB_PASSWORD=CHANGE_ME_GENERATE_ME

# ---------------------------------------------------------------------------
# Bifrost gateway (sole default endpoint; authenticated even behind Tailscale)
# ---------------------------------------------------------------------------
BIFROST_CONFIG_FILE=./config/bifrost/config.json
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=CHANGE_ME_GENERATE_ME
BIFROST_ENCRYPTION_KEY=CHANGE_ME_GENERATE_ME
# Only needed if you've applied `serveshed tailscale plan`'s Serve commands
# for real: the browser Origin Bifrost's own dashboard is served from over
# your tailnet, e.g. https://<machine>.<tailnet>.ts.net (no path, no
# trailing slash). Rendered into config.json's allowed_origins by
# `serveshed`'s own CLI (ADR 0019) -- Bifrost's own "env." substitution
# can't reach a plain array element. Leave unset if you haven't applied
# Serve; the placeholder is dropped cleanly rather than left dangling.
BIFROST_TAILSCALE_ORIGIN=

# Distinct virtual keys per agent/role; never share one key across roles.
BIFROST_VK_HERMES=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_RESEARCH=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_CODING=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_EVAL=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_JUDGE=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_WEBUI=sk-bf-CHANGE_ME_GENERATE_ME
BIFROST_VK_REFUSAL_PILOT=sk-bf-CHANGE_ME_GENERATE_ME

# Backend routes (private Docker network only; never expose directly)
OLLAMA_URL=http://ollama:11434
VLLM_URL=http://vllm:8000
OTEL_COLLECTOR_URL=http://otel-collector:4318/v1/traces

# ---------------------------------------------------------------------------
# Ollama (interactive inference; one loaded model, short keep-alive)
# ---------------------------------------------------------------------------
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=2m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# ---------------------------------------------------------------------------
# Open WebUI (chat UI with history; talks only to Bifrost, never Ollama
# directly — see ADR 0014). Runs on the no-egress backend network, so every
# background fetch it might otherwise attempt at startup is disabled.
# ---------------------------------------------------------------------------
# Session/JWT signing key; regenerated per host, never share across hosts.
OPENWEBUI_SECRET_KEY=CHANGE_ME_GENERATE_ME
# true = multi-account mode: first signup becomes admin, each person gets
# their own account/history, model access restrictable per group. Cannot be
# flipped to false later without losing every account's sessions — see
# ADR 0015 before changing this.
WEBUI_AUTH=true

# ---------------------------------------------------------------------------
# vLLM (batch/concurrency; disabled until explicitly enabled and reviewed)
# ---------------------------------------------------------------------------
SERVESHED_ENABLE_VLLM=false
VLLM_MODEL_ID=REVIEW_REQUIRED
VLLM_SERVED_MODEL_NAME=local-qwen-batch
VLLM_API_KEY=vllm-CHANGE_ME_GENERATE_ME
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=2

# Optional; only needed for gated Hugging Face artifacts. Leave blank by default.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LiteLLM (isolated `experimental` profile only; never chained with Bifrost)
# ---------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-CHANGE_ME_GENERATE_ME
